        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres devises détectées. Utilisez un relevé en USD uniquement."
          }
        }
      }
    },
    "交易字段无效：只接受有效日期、商家、分类和正数 USD 美分。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
