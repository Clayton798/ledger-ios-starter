            "value": "%@ · %@ %@ / budget %@"
          }
        }
      }
    },
    "从所选日期统计到下次开始的前一天。短月份没有这一天时，使用该月最后一天。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从所选日期统计到下次开始的前一天。短月份没有这一天时，使用该月最后一天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each period ends the day before the next starts. Short months use their last day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque période finit la veille de la suivante. Pour un mois plus court, son dernier jour est utilisé."
          }
        }
      }
    },
    "按自然月统计，例如 9 月 1 日至 9 月 30 日。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按自然月统计，例如 9 月 1 日至 9 月 30 日。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use calendar months, such as September 1–30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les mois calendaires, par exemple du 1er au 30 septembre."
          }
        }
      }
    },
    "每期预算独立保存，未填写的周期不会自动沿用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每期预算独立保存，未填写的周期不会自动沿用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each period has its own budget. Unset periods do not inherit one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque période a son propre budget. Aucun budget n’est repris automatiquement."
          }
        }
      }
    },
    "金额单位 USD。留空表示该分类不设预算，0 表示不计划支出。切换周期会重新载入已保存值，请先保存修改。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额单位 USD。留空表示该分类不设预算，0 表示不计划支出。切换周期会重新载入已保存值，请先保存修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are in USD. Leave blank for no budget, or enter 0 for no planned spending. Save changes before switching periods."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montants en USD. Laisser vide pour aucun budget, ou saisir 0 pour aucune dépense prévue. Enregistrez avant de changer de période."
          }
        }
      }
    },
    "所有历史消费会按新的周期重新统计，消费本身的日期与金额不变。每期预算按起始月份保留，金额不会自动增减；修改后请核对各期预算。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有历史消费会按新的周期重新统计，消费本身的日期与金额不变。每期预算按起始月份保留，金额不会自动增减；修改后请核对各期预算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past spending will be grouped into the new periods. Purchase dates and amounts stay unchanged. Budgets remain tied to their starting month; review them after changing the start day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses seront regroupées selon les nouvelles périodes, sans changer leurs dates ni leurs montants. Les budgets restent liés au mois de début ; vérifiez-les après modification."
          }
        }
      }
    },
    "历史记录会重新分期，预算按起始月份保留。不会修改或删除消费记录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录会重新分期，预算按起始月份保留。不会修改或删除消费记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries will be regrouped. Budgets stay with their starting month. No purchases will be changed or deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écritures seront regroupées. Les budgets restent liés au mois de début. Aucun achat ne sera modifié ni supprimé."
          }
        }
      }
    },
    "先填你确定的固定支出，再给吃饭和购物留额度。洗衣可按每周次数估算；订阅按实际账单填写，未确定的先留空。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先填你确定的固定支出，再给吃饭和购物留额度。洗衣可按每周次数估算；订阅按实际账单填写，未确定的先留空。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with fixed costs, then allow for food and shopping. Estimate laundry by weekly use and subscriptions by actual bills. Leave uncertain amounts blank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par les frais fixes, puis prévoyez les repas et les achats. Estimez la lessive selon sa fréquence et les abonnements selon les factures. Laissez les montants incertains vides."
          }
        }
      }
    },
    "未设预算的分类不计入上方合计。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设预算的分类不计入上方合计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories without a budget are excluded from the total above."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories sans budget sont exclues du total ci-dessus."
          }
        }
      }
    },
    "每日支出，非累计；未消费的日期显示为 0。显示到今天或已有记录的最后一天。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日支出，非累计；未消费的日期显示为 0。显示到今天或已有记录的最后一天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily spending, not cumulative. Days without purchases show 0. Shown through today or the last recorded date."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépenses quotidiennes, non cumulées. Les jours sans achat affichent 0, jusqu’à aujourd’hui ou la dernière date enregistrée."
          }
        }
      }
    },
    "从第一笔开始。选择付款截图，或手动记录消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从第一笔开始。选择付款截图，或手动记录消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a payment screenshot or add your first purchase manually."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une capture de paiement ou ajoutez votre premier achat manuellement."
          }
        }
      }
    },
    "选择付款截图，或手动记录今天的消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择付款截图，或手动记录今天的消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a payment screenshot or enter today’s purchase manually."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une capture de paiement ou saisissez la dépense du jour."
          }
        }
      }
    },
    "保存消费后，就能在这里查看分类和趋势。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存消费后，就能在这里查看分类和趋势。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a purchase to see categories and trends here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une dépense pour voir ici les catégories et les tendances."
          }
        }
      }
    },
    "你的私人美元账本。无需注册，截图或手动记录，数据留在设备上。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的私人美元账本。无需注册，截图或手动记录，数据留在设备上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal USD ledger. No sign-up. Use screenshots or manual entries; data stays on your device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carnet personnel en USD. Sans inscription. Captures ou saisie manuelle ; les données restent sur votre appareil."
          }
        }
      }
    },
    "周期起始日可在设置中修改。预算每期单独填写，仅支持美元正向支出。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周期起始日可在设置中修改。预算每期单独填写，仅支持美元正向支出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the period start day in Settings. Set a separate budget for each period. Only positive USD purchases are supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le jour de début dans Réglages. Définissez un budget par période. Seules les dépenses positives en USD sont prises en charge."
          }
        }
      }
    },
    "截图日期不明确，请填写实际消费日期。图片里的“今天／昨天”不能按导入当天计算。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图日期不明确，请填写实际消费日期。图片里的“今天／昨天”不能按导入当天计算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the actual purchase date. “Today/yesterday” in a screenshot cannot be based on the import day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la date réelle de l’achat. « Aujourd’hui/hier » dans une capture ne désigne pas le jour de l’importation."
          }
        }
      }
    },
    "请确认实际消费日期；截图里的今天／昨天不代表导入当天。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认实际消费日期；截图里的今天／昨天不代表导入当天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the purchase date; “today/yesterday” is relative to the screenshot, not the import day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez la date d’achat ; « aujourd’hui/hier » concerne la capture, pas le jour de l’importation."
          }
        }
      }
    },
    "仅有 $ 不能确定币种。请对照原付款页面确认；本版不记退款、冲正或其他币种。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅有 $ 不能确定币种。请对照原付款页面确认；本版不记退款、冲正或其他币种。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A $ symbol alone does not confirm USD. Check the original payment. Refunds, reversals and other currencies are not supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le symbole $ seul ne confirme pas l’USD. Vérifiez le paiement original. Les remboursements, annulations et autres devises ne sont pas pris en charge."
          }
        }
      }
    },
    "发现多个金额，请选出这一笔的实际支付金额。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现多个金额，请选出这一笔的实际支付金额。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several amounts were found. Choose the actual amount paid for this purchase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs montants détectés. Choisissez le montant réellement payé pour cet achat."
          }
        }
      }
    },
    "未识别到金额，请手动输入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未识别到金额，请手动输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No amount detected. Enter it manually."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun montant détecté. Saisissez-le manuellement."
          }
        }
      }
    },
    "识别可能有误，请逐项核对。多笔交易请分别截取；多个金额不会相加。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别可能有误，请逐项核对。多笔交易请分别截取；多个金额不会相加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition may be wrong; check every field. Use statement import for multiple purchases. Amounts are not added together."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance peut être erronée ; vérifiez chaque champ. Utilisez l’import de relevé pour plusieurs achats. Les montants ne sont pas additionnés."
          }
        }
      }
    },
    "请核对上方信息。点击右上方“确认并保存”即确认这是一笔正向美元消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对上方信息。点击右上方“确认并保存”即确认这是一笔正向美元消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the details above. Confirm & save records this as a positive USD purchase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les informations. Confirmer et enregistrer valide une dépense positive en USD."
          }
        }
      }
    },
    "保存后会记住此商家的分类，下次自动填好。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会记住此商家的分类，下次自动填好。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category will be remembered for this merchant next time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie sera mémorisée pour ce commerçant."
          }
        }
      }
    },
    "已参考你上次保存的同名商家分类，仍可修改。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已参考你上次保存的同名商家分类，仍可修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category comes from your previous entry for this merchant. You can change it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie vient de votre dernière écriture pour ce commerçant. Vous pouvez la modifier."
          }
        }
      }
    },
    "此记录已作废，保留供备份核对，不计入支出。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此记录已作废，保留供备份核对，不计入支出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry is voided. It remains for reference and is excluded from spending."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette écriture est annulée. Elle reste consultable et est exclue des dépenses."
          }
        }
      }
    },
    "原记录仍保留在备份中，但不再计入支出。作废不能代替部分退款记账。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原记录仍保留在备份中，但不再计入支出。作废不能代替部分退款记账。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original remains in backups but no longer counts as spending. Voiding is not a partial refund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’original reste dans les sauvegardes mais ne compte plus comme dépense. L’annulation ne remplace pas un remboursement partiel."
          }
        }
      }
    },
    "同一天已有相同商家、相同金额的记录，请确认确实是另一笔消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一天已有相同商家、相同金额的记录，请确认确实是另一笔消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An entry with this date, merchant and amount already exists. Confirm this is a separate purchase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une écriture de même date, commerçant et montant existe. Confirmez qu’il s’agit d’un autre achat."
          }
        }
      }
    },
    "此图没有明确 USD 标识，请核对实际币种。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图没有明确 USD 标识，请核对实际币种。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No explicit USD label was found. Check the currency."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mention explicite USD. Vérifiez la devise."
          }
        }
      }
    },
    "这张截图的此条消费已经保存，本次跳过。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张截图的此条消费已经保存，本次跳过。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase from this screenshot is already saved and will be skipped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat de cette capture est déjà enregistré et sera ignoré."
          }
        }
      }
    },
    "疑似已记过：日期、商家和金额相同。默认不选；若确实是另一笔，请勾选并在下方允许同额消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疑似已记过：日期、商家和金额相同。默认不选；若确实是另一笔，请勾选并在下方允许同额消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible duplicate: same date, merchant and amount. Unselected by default. Select it and allow matching purchases below only if it is separate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doublon possible : même date, commerçant et montant. Non sélectionné par défaut. Ne l’autorisez ci-dessous que s’il s’agit d’un achat distinct."
          }
        }
      }
    },
    "一次保存全部所选记录；任何一笔校验失败都不会写入。相同截图行重复导入仍会被阻止。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次保存全部所选记录；任何一笔校验失败都不会写入。相同截图行重复导入仍会被阻止。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All selected entries save together. If any fails validation, none are saved. Reimporting the same screenshot row is blocked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écritures sélectionnées sont enregistrées ensemble. Si une vérification échoue, aucune n’est enregistrée. Les lignes déjà importées sont bloquées."
          }
        }
      }
    },
    "未找到可拆分的金额行，请换一张清晰账单图或手动记账。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可拆分的金额行，请换一张清晰账单图或手动记账。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transaction rows found. Try a clearer statement or enter purchases manually."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ligne de dépense trouvée. Essayez un relevé plus net ou la saisie manuelle."
          }
        }
      }
    },
    "不保存原截图和识别原文。账本只在这台设备上，不会自动云备份；删除 App 前，请先保存副本。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存原截图和识别原文。账本只在这台设备上，不会自动云备份；删除 App 前，请先保存副本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original screenshots and recognized text are not stored. The ledger stays on this device without automatic cloud backup. Save a copy before deleting the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures et textes reconnus ne sont pas conservés. Le carnet reste sur cet appareil sans sauvegarde automatique dans le cloud. Enregistrez une copie avant de supprimer l’app."
          }
        }
      }
    },
    "无需登录，没有广告。截图在手机上识别，不会自动读取银行卡消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需登录，没有广告。截图在手机上识别，不会自动读取银行卡消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No login or ads. Screenshots are read on-device; bank transactions are not fetched automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans connexion ni publicité. Les captures sont lues sur l’appareil ; aucune transaction bancaire n’est récupérée automatiquement."
          }
        }
      }
    },
    "如果恢复的文件选错了，可以先保存恢复前的副本，再用它找回记录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果恢复的文件选错了，可以先保存恢复前的副本，再用它找回记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you restored the wrong file, save the pre-restore copy and use it to recover your entries."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez restauré le mauvais fichier, enregistrez la copie précédente pour récupérer vos écritures."
          }
        }
      }
    },
    "导出到 iCloud Drive 等位置由你选择，可能触发该服务同步。仅支持正向美元支出，不支持退款冲抵及汇率换算。预算提醒仅在 App 内显示，不限制银行卡消费。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出到 iCloud Drive 等位置由你选择，可能触发该服务同步。仅支持正向美元支出，不支持退款冲抵及汇率换算。预算提醒仅在 App 内显示，不限制银行卡消费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose where to save copies; services such as iCloud Drive may sync them. Only positive USD purchases are supported, without refund offsets or currency conversion. Budgets are in-app guidance, not card limits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous choisissez où enregistrer les copies ; iCloud Drive peut les synchroniser. Seules les dépenses positives en USD sont prises en charge, sans déduction des remboursements ni conversion. Les budgets sont indicatifs et ne limitent pas votre carte."
          }
        }
      }
    },
    "备份包含 %lld 条记录（含作废）。已存在的相同记录不会重复添加。你的现有消费会保留，预算和周期起始日会改用文件里的设置。旧版通用预算只会用于恢复时的本期。开始前会自动留存一份当前账本。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含 %lld 条记录（含作废）。已存在的相同记录不会重复添加。你的现有消费会保留，预算和周期起始日会改用文件里的设置。旧版通用预算只会用于恢复时的本期。开始前会自动留存一份当前账本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup has %lld entries, including voided ones. Identical entries are not duplicated. Current purchases are kept; budgets and period settings come from the file. Legacy shared budgets apply only to the current period. A copy is saved before restoring."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde contient %lld écritures, annulations comprises. Les écritures identiques ne sont pas dupliquées. Vos achats sont conservés ; les budgets et périodes viennent du fichier. Les anciens budgets communs ne s’appliquent qu’à la période actuelle. Une copie est conservée avant restauration."
          }
        }
      }
    },
    "账本暂时无法读取": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账本暂时无法读取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ledger unavailable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnet indisponible"
          }
        }
      }
    },
    "已停止写入保护记录。请到设置保存原始文件副本，再尝试重新打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止写入保护记录。请到设置保存原始文件副本，再尝试重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving is disabled to protect entries. Save the original file in Settings, then try reopening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écriture est désactivée pour protéger les données. Enregistrez le fichier original dans Réglages, puis rouvrez l’app."
          }
        }
      }
    },
    "账本暂时无法读取，已停止写入保护记录。请保存原始副本后再尝试重新打开，不要删除 App。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账本暂时无法读取，已停止写入保护记录。请保存原始副本后再尝试重新打开，不要删除 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ledger cannot be read. Saving is disabled to protect it. Save the original copy and reopen the app. Do not delete the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carnet ne peut pas être lu. L’écriture est désactivée pour le protéger. Enregistrez une copie originale et rouvrez l’app, sans la supprimer."
          }
        }
      }
    },
    "从文件找回账本": {
